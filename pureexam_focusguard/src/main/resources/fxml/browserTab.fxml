<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.web.WebView?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group14.BrowserTabController">
   <children>
      <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #f4f4f4; -fx-border-color: #cccccc; -fx-border-width: 0 0 1 0;">
         <padding>
            <Insets bottom="5.0" left="10.0" right="10.0" top="5.0" />
         </padding>
         <children>
            <Button mnemonicParsing="false" onAction="#goBack" text="←" />
            <Button mnemonicParsing="false" onAction="#goForward" text="→" />
            <Button mnemonicParsing="false" onAction="#reload" text="重新整理" />
            <TextField fx:id="urlField" onAction="#handleUrlInput" promptText="輸入網址並按 Enter..." HBox.hgrow="ALWAYS" />
            <ComboBox fx:id="historyCombo" prefWidth="250.0" promptText="歷史紀錄" />
         </children>
      </HBox>
      <WebView fx:id="webView" VBox.vgrow="ALWAYS" />
   </children>
</VBox>