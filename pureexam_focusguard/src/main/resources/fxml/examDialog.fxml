<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="400.0" prefHeight="200.0" spacing="25.0" style="-fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group14.ExamDialogController">
   <children>
      <HBox alignment="CENTER" spacing="30.0" VBox.vgrow="ALWAYS">
         <children>
            <Button fx:id="btnTeacher" mnemonicParsing="false" onAction="#handleTeacher" prefHeight="50.0" prefWidth="140.0" style="-fx-font-size: 16px;" text="建立考試" />
            <Button mnemonicParsing="false" onAction="#handleStudent" prefHeight="50.0" prefWidth="140.0" style="-fx-font-size: 16px;" text="進入考場" />
         </children>
      </HBox>
      
      <HBox alignment="CENTER_RIGHT">
         <children>
            <Button mnemonicParsing="false" onAction="#handleCancel" prefHeight="30.0" prefWidth="80.0" text="取消" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="20.0" left="25.0" right="25.0" top="25.0" />
   </padding>
</VBox>