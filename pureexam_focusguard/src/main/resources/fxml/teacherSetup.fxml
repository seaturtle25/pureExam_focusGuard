<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<VBox spacing="15.0" style="-fx-padding: 20;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group14.TeacherSetupController">
   <children>
      <VBox fx:id="blockContainer" VBox.vgrow="ALWAYS" />
      
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Label text="請輸入考試時間 (分鐘, 不得小於1分鐘):" />
            <TextField fx:id="timeField" prefWidth="80.0" promptText="120" />
            <Button mnemonicParsing="false" onAction="#handleExport" text="下載考試設定檔 (.oasis)" />
         </children>
      </HBox>
   </children>
</VBox>