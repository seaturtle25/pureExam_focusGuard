<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="600.0" prefWidth="800.0" spacing="25.0" style="-fx-background-color: #f7f6e8ef;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group14.PomodoroController">
    <children>
        <HBox alignment="CENTER" spacing="15.0">
            <children>
                <!--<Button fx:id="backBtn" onAction="#handleBack" style="-fx-background-color: transparent; -fx-border-color: #8A9597; -fx-border-radius: 5; -fx-cursor: hand;" text="← 返回" textFill="#8a9597">
                     <font>
                         <Font name="System Bold" size="14.0" />
                     </font>
                </Button>-->
                
                <Label text="設定時間 (min):" textFill="#666666">
                    <font>
                        <Font name="System Bold" size="15.0" />
                    </font>
                    <HBox.margin>
                        <Insets left="20.0" />
                    </HBox.margin>
                </Label>
                
                <Spinner fx:id="timeSpinner" editable="true" prefWidth="80.0" style="-fx-font-size: 14px; -fx-background-color: transparent;" />
                
                <Button fx:id="startBtn" onAction="#handleStart" style="-fx-background-color: #8A9597; -fx-cursor: hand;" text="開始計時" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Button>
            </children>
        </HBox>

        <Label fx:id="timerLabel" text="25:00" textFill="#4a4a4a">
            <font>
                <Font name="System Bold" size="85.0" />
            </font>
        </Label>
        
        <Label fx:id="statusLabel" text="請設定時間並按下開始" textFill="#888888">
            <font>
                <Font size="15.0" />
            </font>
        </Label>

        <HBox alignment="CENTER" spacing="20.0">
            <children>
                <Button fx:id="pauseBtn" onAction="#handlePause" style="-fx-background-color: transparent; -fx-border-color: #8A9597; -fx-border-radius: 5; -fx-text-fill: #8A9597; -fx-cursor: hand;" text="Pause">
                    <font>
                        <Font size="14.0" />
                    </font>
                    <padding>
                        <Insets bottom="6.0" left="20.0" right="20.0" top="6.0" />
                    </padding>
                </Button>
                <Button fx:id="resetBtn" onAction="#handleReset" style="-fx-background-color: transparent; -fx-border-color: #8A9597; -fx-border-radius: 5; -fx-text-fill: #8A9597; -fx-cursor: hand;" text="Reset">
                    <font>
                        <Font size="14.0" />
                    </font>
                    <padding>
                        <Insets bottom="6.0" left="20.0" right="20.0" top="6.0" />
                    </padding>
                </Button>
            </children>
            <VBox.margin>
                <Insets top="10.0" />
            </VBox.margin>
        </HBox>
            <Button fx:id="browserBtn" onAction="#openBrowser" visible="false" style="-fx-background-color: transparent; -fx-border-color: #8A9597; -fx-border-radius: 5; -fx-text-fill: #8A9597; -fx-cursor: hand;" text="Browser">
                <font>
                    <Font size="14.0" />
                </font>
                <padding>
                    <Insets bottom="6.0" left="20.0" right="20.0" top="6.0" />
                </padding>
            </Button>
    </children>
</VBox>