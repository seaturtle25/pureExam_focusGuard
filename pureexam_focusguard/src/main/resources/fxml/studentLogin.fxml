<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="30.0" prefWidth="600.0" prefHeight="400.0" style="-fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group14.StudentLoginController">
   <children>
      <Label text="OASIS 考試模式" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #333333;"/>
      <Label text="請先匯入由老師提供的考試設定檔，完成後即可開始考試。" style="-fx-font-size: 14px; -fx-text-fill: #666666;" />

      <Button fx:id="importBtn" mnemonicParsing="false" onAction="#handleImport" prefHeight="60.0" prefWidth="280.0" style="-fx-font-size: 16px; -fx-cursor: hand;" text="選擇考試設定檔 (.oasis)" /> 

      <Button mnemonicParsing="false" onAction="#handleStartExam" prefHeight="50.0" prefWidth="200.0" style="-fx-font-size: 16px; -fx-background-color: #ffdd95; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="開始考試" /> 
   </children>
   <padding>
      <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
   </padding>
</VBox>